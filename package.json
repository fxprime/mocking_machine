{
  "name": "mocking-machine-console",
  "productName": "Mocking Machine",
  "version": "0.2.0",
  "description": "Desktop console for the Mocking Machine rotating machinery test rig",
  "author": {
    "name": "Thanabadee Bulunseechart, Modulemore Co., Ltd.",
    "email": "thanabadee_bc@hotmail.com"
  },
  "homepage": "https://github.com/fxprime/mocking_machine",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "exports": {
    "./api": "./lib/mocking-machine/index.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64",
    "pack:mac": "electron-builder --mac --dir",
    "test:desktop": "node scripts/test_desktop.mjs",
    "test:docs": "node scripts/test_docs.mjs",
    "test:web": "node scripts/test_web.mjs && node scripts/test_motion_limiter.mjs && node scripts/test_step_response.mjs && node scripts/test_velocity_step_sequence.mjs && node scripts/test_csv_export.mjs && node scripts/test_parameter_csv.mjs && node scripts/test_rotor_position.mjs && node scripts/test_encoder_calibration.mjs && node scripts/test_profile_collection.mjs && node scripts/test_rotor_load.mjs && node scripts/test_run_recording.mjs && node scripts/test_baud_preference.mjs && node scripts/test_serial_bandwidth.mjs && node scripts/test_connection_sync.mjs && node scripts/test_communication_metrics.mjs && node scripts/test_machine_api.mjs",
    "test:api": "node scripts/test_machine_api.mjs"
  },
  "devDependencies": {
    "@electron/osx-sign": "1.3.1",
    "electron": "43.2.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.modulemore.mockingmachine",
    "asar": true,
    "files": [
      "desktop/**/*",
      "lib/mocking-machine/**/*",
      "web/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "afterPack": "scripts/after-pack.cjs",
    "mac": {
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "icon": "icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "icon.png",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${name}-${version}-windows-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${name}-${version}-windows-${arch}-portable.${ext}"
    },
    "linux": {
      "category": "Utility",
      "icon": "icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${name}-${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "${name}-${version}-ubuntu-${arch}.${ext}"
    },
    "dmg": {
      "sign": false
    },
    "artifactName": "${name}-${version}-${arch}.${ext}"
  }
}
